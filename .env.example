# Supabase browser configuration (publishable/anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Server-only payment integration; configure in Vercel, never expose to browser
RAZORPAY_KEY_ID=
